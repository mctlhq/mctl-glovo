  {
    "name": "glovo_get_suggestions",
    "title": "Personalized live suggestions",
    "description": "Turn structured repeat, explore, or balanced food intent into 3-5 read-only live Glovo choices. Uses full card-level venue history, re-fetches current products/options, and can attach optional Google Maps quality evidence. Never changes the basket.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "mode": {
          "description": "Repeat familiar venues, explore new venues, or mix both. Default balanced.",
          "type": "string",
          "enum": [
            "repeat",
            "explore",
            "balanced"
          ]
        },
        "query": {
          "type": "string",
          "minLength": 1,
          "description": "Food or product keywords, for example pizza, sushi, or burger."
        },
        "venue_query": {
          "description": "Optional venue name constraint, for example a favorite restaurant.",
          "type": "string",
          "minLength": 1
        },
        "item_mode": {
          "description": "Prefer Easy Reorder items, different items at a familiar venue, or any matching live item.",
          "type": "string",
          "enum": [
            "repeat",
            "different",
            "any"
          ]
        },
        "known_liked_only": {
          "description": "Apply only when the user explicitly says a venue is liked; historical purchase alone does not prove satisfaction.",
          "type": "boolean"
        },
        "quality_preference": {
          "description": "Evidence preference. Google remains display-only because it is not part of the backtested personalized model.",
          "type": "string",
          "enum": [
            "personal",
            "glovo",
            "google",
            "balanced"
          ]
        },
        "novelty_tolerance": {
          "description": "Exploration share for balanced intent. Default 0.4.",
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "max_choices": {
          "description": "Return 3-5 choices. Default 5; fewer may be returned when current products are unavailable.",
          "type": "integer",
          "minimum": 3,
          "maximum": 5
        },
        "include_google_quality": {
          "description": "Request optional Google Places quality evidence for the final shortlist. Requires configured GOOGLE_MAPS_API_KEY.",
          "type": "boolean"
        },
        "include_google_reviews": {
          "description": "Explicitly request Google review text for at most the first three matched finalists. May increase Places billing; preserves author/source attribution.",
          "type": "boolean"
        },
        "history_refresh": {
          "description": "Incrementally refresh the newest order page by default, or force a complete cursor walk.",
          "type": "string",
          "enum": [
            "incremental",
            "full"
          ]
        }
      },
      "required": [
        "query"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "execution": {
      "taskSupport": "forbidden"
    }
